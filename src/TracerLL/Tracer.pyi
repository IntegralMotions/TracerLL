from collections.abc import Sequence
from typing import Union

class Tracer:
    def __init__(self, port: str, baud: int, receive_queue_capacity: int = 1024, idle_read_delay_us: int = 100) -> None: ...
    @property
    def idle_read_delay_us(self) -> int: ...
    def start(self) -> bool: ...
    def stop(self) -> None: ...
    def get_messages(self) -> list[list[int]]: ...
    def dropped_messages(self) -> int: ...
    def write_message(self, message: Union[bytes, Sequence[int]]) -> bool: ...
