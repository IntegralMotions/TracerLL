from collections.abc import Sequence
from typing import Union

class Tracer:
    def __init__(self, port: str, baud: int) -> None: ...
    def start(self) -> bool: ...
    def stop(self) -> None: ...
    def get_messages(self) -> list[bytes]: ...
    def write_message(self, message: Union[bytes, Sequence[int]]) -> None: ...
